# Copy this file to .env and fill in values. Never commit .env.
# All paths default to ./data (mounted into the container by docker-compose.yml).

CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db
VECTOR_DIR=./data/index
STATE_DB=./data/state.db

# Blank = system date. Set to YYYY-MM-DD to make answers deterministic.
APP_TODAY=

# LLM provider: mock (default; no external calls, unverified extracts only) | groq | gemini
# Set gemini (or groq) for live answers. TASK.pdf 10.3 requires one of OpenAI, Anthropic or Gemini.
LLM_PROVIDER=mock
# Required only when LLM_PROVIDER=groq. Never commit a real key.
GROQ_API_KEY=
# Required only when LLM_PROVIDER=groq. No default: set it to a model ID you verified in your Groq console.
GROQ_MODEL=
LLM_TIMEOUT_SECONDS=20

# Required only when LLM_PROVIDER=gemini. Never commit a real key.
GEMINI_API_KEY=
# Required only when LLM_PROVIDER=gemini. No default: set it to a model ID you verify in Google AI Studio.
GEMINI_MODEL=

# Retrieval: chunks taken from the in-effect set and from the upcoming set per question.
RAG_TOP_K=12

# Local embedding model (runs on CPU).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Only needed when Tesseract is not on PATH (Windows: C:\Program Files\Tesseract-OCR\tesseract.exe).
TESSERACT_CMD=

LOG_LEVEL=INFO
